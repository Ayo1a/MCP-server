# Copy this file to `.env` and adjust. `.env` is gitignored — never commit real keys.
#
# ── Which LLM should the bundled n8n agent use? ───────────────────────────────
# ollama  -> fully local, NO API key, zero setup for users (default). Heavier: pulls a model.
# openai  -> uses OpenAI. Light/fast, but set OPENAI_API_KEY below. Shared by all users.
LLM=ollama

# Model pulled/used by the local Ollama container (only when LLM=ollama).
OLLAMA_MODEL=llama3.2

# Your OpenAI key (only needed when LLM=openai). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Fixed encryption key so seeded n8n credentials survive restarts ───────────
# Any long random string; keep it stable. Change it and previously-seeded credentials stop decrypting.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
